// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  password         String
  role             Role             @default(USER)
  school           String?
  subject          String?
  grade            String?
  bio              String?
  isPublic         Boolean          @default(false)
  darkMode         Boolean          @default(false)
  onboarded        Boolean          @default(false)
  notifyChat       Boolean          @default(true)
  notifyLikes      Boolean          @default(true)
  notifyCalendar   Boolean          @default(true)
  notifyKI         Boolean          @default(true)
  notifyEmail      Boolean          @default(false)
  notifyFridayDigest Boolean        @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?
  students         Student[]
  chatMessages     ChatMessage[]
  posts            Post[]
  privateNotes     PrivateNote[]
  sentMessages     DirectMessage[]  @relation("SentMessages")
  receivedMessages DirectMessage[]  @relation("ReceivedMessages")
  lessonPlans      LessonPlan[]
  ratings          Rating[]
  lessonPlanLikes  LessonPlanLike[]
  featureRequests  FeatureRequest[]
  votes            Vote[]
  errorReports     ErrorReport[]
  notifications    Notification[]
  calendarEvents   CalendarEvent[]
  calendarSubjects CalendarSubject[]
  terminlisteEvents TerminlisteEvent[]
  activityLogs     ActivityLog[]
  classProfiles    ClassProfile[]
  timetableEntries TimetableEntry[]
  schoolBreaks     SchoolBreak[]
}

model Student {
  id        String        @id @default(cuid())
  label     String
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      FeedbackLog[]
  createdAt DateTime      @default(now())
}

model FeedbackLog {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task        String
  positive    String
  improve     String
  hasProgress Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ClassProfile {
  id          String     @id @default(cuid())
  name        String
  description String?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs        ClassLog[]
  createdAt   DateTime   @default(now())
}

model ClassLog {
  id             String       @id @default(cuid())
  classProfileId String
  classProfile   ClassProfile @relation(fields: [classProfileId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model LessonPlan {
  id              String           @id @default(cuid())
  title           String
  subject         String
  grade           String
  description     String
  content         String?
  fileData        Bytes?
  fileName        String?
  fileType        String?
  fileSize        Int?
  rightsConfirmed Boolean          @default(false)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings         Rating[]
  likes           LessonPlanLike[]
  createdAt       DateTime         @default(now())
}

model Rating {
  id            String     @id @default(cuid())
  score         Int
  comment       String?
  whatWorked    String?
  whatDidntWork String?
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlanId  String
  lessonPlan    LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([userId, lessonPlanId])
}

model LessonPlanLike {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, lessonPlanId])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model PrivateNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String
  period    String?
  source    String?
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id           String           @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  endDate      DateTime?
  location     String?
  category     String           @default("undervisning")
  reminderSent Boolean          @default(false)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      CalendarSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
}

model CalendarSubject {
  id              String            @id @default(cuid())
  name            String
  colorIndex      Int
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          CalendarEvent[]
  timetableEntries TimetableEntry[]
  createdAt       DateTime          @default(now())

  @@unique([userId, name])
}

model TimetableEntry {
  id        String           @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  title     String
  notes     String?
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   CalendarSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
}

model SchoolBreak {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model TerminlisteEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  grade        String
  reminderSent Boolean  @default(false)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model FeatureRequest {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("ny funksjon")
  status      String   @default("innsendt")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes       Vote[]
  createdAt   DateTime @default(now())
}

model Vote {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, featureRequestId])
}

model ErrorReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page        String
  description String
  error       String?
  status      String   @default("innsendt")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Idea {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("Annet")
  realized    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}
