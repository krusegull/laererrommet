// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String           @id @default(cuid())
  name             String
  email            String           @unique
  password         String
  role             Role             @default(USER)
  school           String?
  subject          String?
  grade            String?
  bio              String?
  isPublic         Boolean          @default(false)
  darkMode         Boolean          @default(false)
  onboarded        Boolean          @default(false)
  notifyChat       Boolean          @default(true)
  notifyLikes      Boolean          @default(true)
  notifyCalendar   Boolean          @default(true)
  notifyKI         Boolean          @default(true)
  notifyEmail      Boolean          @default(false)
  notifyFridayDigest Boolean        @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  lastLoginAt      DateTime?
  students         Student[]
  chatMessages     ChatMessage[]
  posts            Post[]
  privateNotes     PrivateNote[]
  sentMessages     DirectMessage[]  @relation("SentMessages")
  receivedMessages DirectMessage[]  @relation("ReceivedMessages")
  lessonPlans      LessonPlan[]
  ratings          Rating[]
  lessonPlanLikes  LessonPlanLike[]
  featureRequests  FeatureRequest[]
  votes            Vote[]
  errorReports     ErrorReport[]
  notifications    Notification[]
  calendarEvents   CalendarEvent[]
  calendarSubjects CalendarSubject[]
  terminlisteEvents TerminlisteEvent[]
  activityLogs     ActivityLog[]
  classProfiles    ClassProfile[]
  timetableEntries TimetableEntry[]
  schoolBreaks     SchoolBreak[]
  weeklyNotes      WeeklyNote[]
  importantNotes   ImportantNote[]
  vurderingsMaler  VurderingsMal[]
  elevTekster      ElevTekst[]
}

model Student {
  id            String          @id @default(cuid())
  label         String
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          FeedbackLog[]
  /// Roster-oppføringer i klassekart som peker til denne delte elevprofilen -
  /// samme elev kan stå i flere klasser, men statistikk/vurderinger samles
  /// her uansett hvilken klasse de kom fra.
  classStudents ClassStudent[]
  elevTekster   ElevTekst[]
  createdAt     DateTime        @default(now())
}

model FeedbackLog {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task        String
  positive    String
  improve     String
  hasProgress Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ClassProfile {
  id            String         @id @default(cuid())
  name          String
  description   String?
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          ClassLog[]
  students      ClassStudent[]
  seatingCharts SeatingChart[]
  createdAt     DateTime       @default(now())
}

model ClassStudent {
  id             String       @id @default(cuid())
  classProfileId String
  classProfile   ClassProfile @relation(fields: [classProfileId], references: [id], onDelete: Cascade)
  name           String
  gender         String
  /// Kobling til den delte elevprofilen (Student/Tilbakemeldingslogg) denne
  /// roster-oppføringen hører til. Settes automatisk (ved eksakt navnetreff,
  /// ellers opprettes en ny elevprofil) første gang eleven brukes et sted som
  /// krever den delte identiteten, f.eks. ved opplasting av en elevtekst.
  studentId      String?
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  elevTekster    ElevTekst[]
  createdAt      DateTime     @default(now())

  @@index([classProfileId])
  @@index([studentId])
}

/// Ett klassekart er ett selvstendig "øyeblikksbilde" av rom + pultoppsett +
/// seteplassering for en klasse. En klasse kan ha flere - typisk ett per
/// skoleuke - og læreren setter selv hvilken uke/år hvert kart gjelder for.
model SeatingChart {
  id             String       @id @default(cuid())
  classProfileId String
  classProfile   ClassProfile @relation(fields: [classProfileId], references: [id], onDelete: Cascade)
  label          String       @default("Kart 1")
  week           Int?
  year           Int?
  roomObjects    Json         @default("[]")
  podLayout      Json         @default("[]")
  pods           Json         @default("[]")
  locks          Json         @default("[]")
  pairHistory    Json         @default("{}")
  grupper        Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([classProfileId])
  @@index([classProfileId, year, week])
}

model ClassLog {
  id             String       @id @default(cuid())
  classProfileId String
  classProfile   ClassProfile @relation(fields: [classProfileId], references: [id], onDelete: Cascade)
  content        String
  createdAt      DateTime     @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  createdAt DateTime @default(now())
}

model DirectMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model LessonPlan {
  id              String           @id @default(cuid())
  title           String
  subject         String
  grade           String
  description     String
  content         String?
  fileData        Bytes?
  fileName        String?
  fileType        String?
  fileSize        Int?
  rightsConfirmed Boolean          @default(false)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  ratings         Rating[]
  likes           LessonPlanLike[]
  createdAt       DateTime         @default(now())
}

model Rating {
  id            String     @id @default(cuid())
  score         Int
  comment       String?
  whatWorked    String?
  whatDidntWork String?
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlanId  String
  lessonPlan    LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  @@unique([userId, lessonPlanId])
}

model LessonPlanLike {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonPlanId String
  lessonPlan   LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, lessonPlanId])
}

model Post {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Int      @default(0)
  createdAt DateTime @default(now())
}

model PrivateNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  content   String
  period    String?
  source    String?
  createdAt DateTime @default(now())
}

model CalendarEvent {
  id           String           @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  endDate      DateTime?
  location     String?
  category     String           @default("undervisning")
  reminderSent Boolean          @default(false)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId    String?
  subject      CalendarSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
}

model CalendarSubject {
  id              String            @id @default(cuid())
  name            String
  colorIndex      Int
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  events          CalendarEvent[]
  timetableEntries TimetableEntry[]
  createdAt       DateTime          @default(now())

  @@unique([userId, name])
}

model TimetableEntry {
  id        String           @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  title     String
  notes     String?
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   CalendarSubject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
}

model SchoolBreak {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model WeeklyNote {
  id        String   @id @default(cuid())
  weekStart DateTime
  dayOfWeek Int
  content   String
  priority  Int?
  completed Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekStart, dayOfWeek])
}

model ImportantNote {
  id        String   @id @default(cuid())
  content   String
  priority  Int?
  completed Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model TerminlisteEvent {
  id           String   @id @default(cuid())
  title        String
  description  String?
  date         DateTime
  grade        String
  reminderSent Boolean  @default(false)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model FeatureRequest {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("ny funksjon")
  status      String   @default("innsendt")
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes       Vote[]
  createdAt   DateTime @default(now())
}

model Vote {
  id               String         @id @default(cuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  featureRequestId String
  featureRequest   FeatureRequest @relation(fields: [featureRequestId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([userId, featureRequestId])
}

model ErrorReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  page        String
  description String
  error       String?
  status      String   @default("innsendt")
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Idea {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String   @default("Annet")
  realized    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  description String
  createdAt   DateTime @default(now())
}

/// En navngitt vurderingsmal (f.eks. "Norsk skriftlig 8. trinn") med egne
/// vektede kriterier og en karakterskala læreren selv definerer - karakter-
/// grenser varierer bevisst fra mal til mal, siden samme poengsum kan bety
/// ulik karakter på ulike trinn.
model VurderingsMal {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Karakterskala: liste av {label, minScore}, sortert stigende på minScore.
  skala       Json                  @default("[]")
  kriterier   VurderingsKriterium[]
  elevTekster ElevTekst[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

/// En opplastet/innlimt elevtekst, matchet til en elev og vurdert mot en
/// vurderingsmal. Poengsum/tilbakemelding settes manuelt av læreren i denne
/// omgangen - ingen KI-vurdering ennå.
model ElevTekst {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classStudentId String?
  classStudent   ClassStudent?  @relation(fields: [classStudentId], references: [id], onDelete: SetNull)
  malId          String
  mal            VurderingsMal  @relation(fields: [malId], references: [id], onDelete: Restrict)
  tittel         String
  tekst          String
  /// Poengsum 0-100 mot malens skala. Null = ikke vurdert ennå.
  score          Int?
  /// Karakter-label slått opp fra malens skala da poengsummen sist ble satt -
  /// lagret som et øyeblikksbilde, så historiske vurderinger ikke endres om
  /// skalaen justeres senere.
  karakter       String?
  tilbakemelding String?
  dato           DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([studentId])
  @@index([malId])
}

model VurderingsKriterium {
  id          String        @id @default(cuid())
  malId       String
  mal         VurderingsMal @relation(fields: [malId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Vekting i prosent - alle kriteriene i en mal skal til sammen bli 100.
  weight      Int
  /// Fritekst: hva som regnes som ekstra bra å få med under dette kriteriet.
  ekstraBra   String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([malId])
}

enum Role {
  USER
  ADMIN
}
