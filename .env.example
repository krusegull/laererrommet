# Kopier denne filen til .env for lokal utvikling: cp .env.example .env

# Opprett en gratis database på https://neon.tech og lim inn connection-stringen herfra.
# Dette skal være den poolede tilkoblingen (hostname med "-pooler") — den brukes av appen i drift.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"

# Valgfri: Neons IKKE-poolede/direkte connection string (hostname UTEN "-pooler").
# Brukes kun av `prisma migrate deploy` ved bygg/deploy, siden migreringer tar en
# Postgres advisory lock som kan tidsavbrytes (feil P1002) gjennom pooleren.
# Faller tilbake til DATABASE_URL hvis ikke satt. Kreves i Vercel-miljøet.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Tilfeldig, hemmelig streng brukt til å signere økter. Generer f.eks. med:
# openssl rand -base64 32
NEXTAUTH_SECRET=""

# URL-en appen kjører på. I produksjon settes denne til appens faktiske URL i Vercel.
NEXTAUTH_URL="http://localhost:3000"

# API-nøkkel fra https://console.anthropic.com — kreves for KI-veilederen og
# de andre KI-drevne funksjonene.
ANTHROPIC_API_KEY=""
